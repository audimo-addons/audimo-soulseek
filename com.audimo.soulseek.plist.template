<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<!--
  launchd agent for the audimo-soulseek addon (native).

  Install:
    cp com.audimo.soulseek.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.audimo.soulseek.plist

  Restart after editing server.py:
    launchctl kickstart -k gui/$UID/com.audimo.soulseek
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.audimo.soulseek</string>

    <key>ProgramArguments</key>
    <array>
        <string><your-clone-of-this-repo>/run_native.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string><your-clone-of-this-repo></string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string><your-home>/.audimo/audimo-soulseek.log</string>
    <key>StandardErrorPath</key>
    <string><your-home>/.audimo/audimo-soulseek.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
